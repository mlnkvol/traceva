DEBUG=false
DEVICE=cpu
REDIS_URL=redis://localhost:6379/0
SAM_CHECKPOINT=checkpoints/sam2_hiera_large.pt
SAM_MODEL_CFG=sam2_hiera_l.yaml
VLM_LAYER_NAMING_ENABLED=true
VLM_LAYER_NAMING_MODEL=microsoft/Florence-2-base
VLM_LAYER_NAMING_DEVICE=cpu
VLM_LAYER_NAMING_PROMPT=<CAPTION>
VLM_LAYER_NAMING_MAX_TOKENS=12
VLM_LAYER_NAMING_CROP_SIZE=384
VLM_CACHE_DIR=/app/.cache/huggingface
VLM_WARMUP_ON_START=true
VLM_ON_DEMAND_LOAD_ENABLED=false
